# Port HTTP (l'hébergeur peut fournir PORT automatiquement)
PORT=3000
NODE_ENV=production

# Chemin privé, hors du dossier public et hors du dépôt Git
LAS_DATA_DIR=./data
LAS_DB_PATH=./data/las.sqlite
LAS_STORAGE_DIR=./storage

# À définir avec une longue valeur aléatoire (au moins 32 caractères)
LAS_SESSION_SECRET=CHANGEZ_CETTE_VALEUR_PAR_UN_SECRET_ALEATOIRE_LONG
